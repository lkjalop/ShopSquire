## ShopSquire environment template (safe defaults only, no real secrets)

# Runtime
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8080

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shopsquire

# Redis / Celery
REDIS_PASSWORD=redis-change-me
REDIS_URL=redis://default:redis-change-me@localhost:6379/0
CELERY_BROKER_URL=redis://default:redis-change-me@localhost:6379/0
CELERY_RESULT_BACKEND=redis://default:redis-change-me@localhost:6379/0

# API keys (replace in production, prefer Vault/KeyVault)
MERCHANT_API_KEY=merchant-key-replace-me
OWNER_API_KEY=owner-key-replace-me
DEVELOPER_API_KEY=developer-key-replace-me
API_KEYS_PATH=config/api_keys.json

# Vault (optional)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_API_KEYS_PATH=shopsquire/api_keys

# Feature flags / controls
FEATURE_FLAGS_PATH=config/feature_flags.json
ML_DECISION_GATE_MODEL_PATH=config/ml_decision_gate_model.json
ML_DECISION_GATE_ACTIVE_POINTER_PATH=config/ml_decision_gate_active.json
ROLLUP_PERCENT_DEFAULT=20
KILL_SWITCH=false
RATE_LIMIT_PER_IP_PER_MIN=120
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend local dev (optional)
VITE_API_KEY=merchant-key-replace-me

# Observability
PROMETHEUS_METRICS_PORT=8000
API_KEYS_AUDIT_PATH=config/api_key_audit.jsonl
LOG_LEVEL=INFO
LOG_FILE=logs/shopsquire/api.log
JAEGER_ENABLED=true
TOKEN_BUDGET_ENABLED=true
TOKEN_BUDGET_DEFAULT_TIER=guest
TOKEN_BUDGET_GUEST_DAILY_TOKENS=10000
TOKEN_BUDGET_GUEST_DAILY_USD=1.00
TOKEN_BUDGET_BASIC_DAILY_TOKENS=10000
TOKEN_BUDGET_BASIC_DAILY_USD=1.00
TOKEN_BUDGET_PREMIUM_DAILY_TOKENS=100000
TOKEN_BUDGET_PREMIUM_DAILY_USD=10.00
TOKEN_BUDGET_ENTERPRISE_DAILY_TOKENS=1000000
TOKEN_BUDGET_ENTERPRISE_DAILY_USD=1000
TOKEN_COST_PER_1K=0.002
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_HEADER=x-webhook-signature
WEBHOOK_TIMESTAMP_HEADER=x-webhook-timestamp
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_REPLAY_TTL_SECONDS=300
SUPPLY_CHAIN_ENABLED=true
SUPPLY_CHAIN_CHECK_TTL=3600
SUPPLY_CHAIN_BASELINE_TTL=604800
SUPPLY_CHAIN_BASELINES_PATH=config/security/supply_chain_baselines.json
SUPPLY_CHAIN_STATUS_TTL=86400
WEBHOOK_ENFORCE_VENDOR_SIGNATURES=true
STRIPE_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
SLACK_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SSRF_ALLOWLIST_HOSTS=
SSRF_DENYLIST_HOSTS=
SSRF_BLOCK_UNRESOLVED=0
INTERNAL_MTLS_REQUIRED=0
INTERNAL_MTLS_PATH_PREFIXES=/api/v1/orchestrator/events,/api/v1/webhooks,/api/v1/ingest
INTERNAL_MTLS_ALLOWED_FINGERPRINTS=
JWT_SIGNING_KEY=replace-with-long-random-string
JWT_ISSUER=shopsquire
JWT_AUDIENCE=shopsquire-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=86400
MODEL_THEFT_GUARD_ENABLED=1
MODEL_THEFT_MAX_EXTRACTION_REQ_PER_HOUR=40
MODEL_THEFT_WATERMARK_KEY=shopsquire-watermark-secret
MODEL_THEFT_WATERMARK_APPEND_TEXT=0
STRIPE_BILLING_ENABLED=0
STRIPE_METERED_PRICE_ID=
XERO_API_BASE=https://api.xero.com
XERO_TENANT_ID=
XERO_ACCESS_TOKEN=
XERO_TIMEOUT_SECONDS=10
SECURITY_AUTOROUTE_ENABLED=true
SECURITY_ESCALATE_MIN_SEVERITY=high
SECURITY_ESCALATE_MIN_SCORE=70
SECURITY_REVIEW_MIN_SEVERITY=warn
SECURITY_REVIEW_MIN_SCORE=30
TOOL_BRIDGE_URL=http://localhost:9001
TOOL_BRIDGE_TIMEOUT=2.0
PREFERENCE_TTL_SECONDS=10800
GDPR_HASHING_ENABLED=true
SECURITY_BLOCK_MODE=403
CV_PROVIDER=ollama
CV_MODEL=llava
CV_MODEL_PACK=agnostic_v1
CV_MODEL_PACK_PATH=config/cv_model_packs.json
CV_DAMAGE_YOLO_MODEL=models/yolov8n.pt
CV_WARMUP_ON_START=false

# Optional CV vision lane (policy gates / demos).
# Uses Ollama multimodal models like `llava:latest` and runs in addition to OCR/forensics.
#
# Ollama location:
# - If the API runs in Docker and Ollama runs on the host, use:
#   OLLAMA_URL=http://host.docker.internal:11434
# - If the API runs on the host, use:
#   OLLAMA_URL=http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
CV_VISION_ENABLED=0
CV_VISION_MODEL=llava:latest
CV_VISION_TIMEOUT_SEC=10

# OCR configuration (Windows)
# Install Tesseract from: https://github.com/UB-Mannheim/tesseract/wiki
# If OCR isn't working, set the full path to the binary.
TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
CV_OCR_PROVIDER=tesseract

# Recommendation pilot. Keep compatibility ON until the human relevance, real-source,
# physical voice, image-provider, and observed rollback gates are complete.
RECOMMEND_CORE_MODE=off
RECOMMEND_CORE_PILOT_SUBJECTS=
RECOMMEND_COMPATIBILITY_CUTOVER_ENABLED=1

# Enrolled official workload/product requirements source. The registry remains fail-closed
# unless every field below plus EXTERNAL_RESEARCH_SOURCE_REVIEWED_BY is configured.
EXTERNAL_RESEARCH_ENABLED=0
EXTERNAL_RESEARCH_SEARCH_URL=
# Only enable for the explicit localhost proof launcher. This permits the first
# request while reachability is still unobserved; it never records a fake success.
EXTERNAL_RESEARCH_LOCAL_PROOF_ENROLLED=0
EXTERNAL_RESEARCH_ALLOW_PRIVATE=0
EXTERNAL_RESEARCH_PROVIDER_ID=local_searxng
EXTERNAL_RESEARCH_PROVIDER_BILLING_CLASS=free
# Optional observation projection from a deployment health probe. Do not set
# healthy/last-success until an actual request or bounded probe has succeeded.
EXTERNAL_RESEARCH_RUNTIME_STATUS=
EXTERNAL_RESEARCH_LAST_SUCCESS_AT=
EXTERNAL_RESEARCH_LAST_FAILURE_AT=
EXTERNAL_RESEARCH_LAST_FAILURE_CODE=
EXTERNAL_RESEARCH_TENANT_ALLOWLIST=
EXTERNAL_RESEARCH_SOURCE_REVIEWED_BY=
EXTERNAL_RESEARCH_SOURCE_LICENCE=
OFFICIAL_REQUIREMENTS_API_URL=
OFFICIAL_REQUIREMENTS_API_KEY=
OFFICIAL_REQUIREMENTS_AUTH_HEADER=Authorization
OFFICIAL_REQUIREMENTS_AUTH_SCHEME=Bearer
OFFICIAL_REQUIREMENTS_PROVIDER_ID=official_requirements_api
OFFICIAL_REQUIREMENTS_DOMAIN_ALLOWLIST=
OFFICIAL_REQUIREMENTS_PUBLISHER_POLICY_ID=
OFFICIAL_REQUIREMENTS_FRESHNESS_SLA_HOURS=24
# Reviewed exact-configuration evidence fixture (local/demo only; default off outside local).
AUTO_SEED_REVIEWED_PRODUCT_EVIDENCE=0
