      "title": "Fraud Provider Latency p99 (by tenant)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(shopsquire_fraud_provider_latency_tenant_seconds_bucket{tenant=~\\\"$tenant\\\"}[5m])) by (le, provider, model, tenant))",
          "refId": "F2"
