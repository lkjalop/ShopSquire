{
  "annotations": {"list": []},
  "panels": [
    {
      "type": "graph",
      "title": "CV Provider Latency (seconds)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(shopsquire_cv_provider_latency_seconds_bucket[5m])) by (le, provider, tier, model))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"show": true}}
    },
    {
      "type": "graph",
      "title": "CV Provider Latency p99 (seconds)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(shopsquire_cv_provider_latency_seconds_bucket[5m])) by (le, provider, tier, model))",
          "refId": "G"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"show": true}}
    },
    {
      "type": "graph",
      "title": "Fraud Provider Latency p99 (seconds)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(shopsquire_fraud_provider_latency_seconds_bucket[5m])) by (le, provider, model))",
          "refId": "H"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"show": true}}
    },
    {
      "type": "graph",
      "title": "Fraud Provider Latency (seconds)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(shopsquire_fraud_provider_latency_seconds_bucket[5m])) by (le, provider, model))",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"show": true}}
    },
    {
      "type": "stat",
      "title": "Cluster Drift Total",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(shopsquire_query_cluster_drift_total)", "refId": "C"}
      ],
      "options": {"reduceOptions": {"calcs": ["last"]}}
    },
    {
      "type": "graph",
      "title": "Drift Ratio (by cluster)",
      "datasource": "Prometheus",
    {
      "type": "graph",
      "title": "CV Provider Latency p99 (by tenant)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(shopsquire_cv_provider_latency_tenant_seconds_bucket{tenant=~\\\"$tenant\\\"}[5m])) by (le, provider, tier, model, tenant))",
          "refId": "E2"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"show": true}}
    },
      "targets": [
        {
          "expr": "sum(rate(shopsquire_query_cluster_drift_ratio_sum[5m])) by (cluster) / sum(rate(shopsquire_query_cluster_drift_ratio_count[5m])) by (cluster)",
          "refId": "D"
        }
      ],
      "options": {"legend": {"show": true}}
    }
  ,
    {
      "type": "graph",
      "title": "CV Provider Latency p95 (by tenant)",
      "datasource": "Prometheus",
