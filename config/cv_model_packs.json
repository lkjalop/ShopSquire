      "title": "Agnostic CV Pack v1",
      "description": "General-purpose CV pack for returns/refunds/warranty across categories.",
      "detector": {
        "type": "yolo",
        "model": "yolov8s.pt"
      },
      "ocr": {
        "provider": "tesseract",
        "fallback": "tesseract"
      },
      "quality": {
        "type": "clip",
        "labels": ["damaged device", "undamaged device", "blurry photo", "invoice document", "serial sticker"]
      },
      "forensics": true,
      "phash": true
    },
