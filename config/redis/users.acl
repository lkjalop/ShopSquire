user default on >redis-change-me ~* &* +@all
user shopsquire_api on >replace-me-redis-api-password ~shopsquire:* ~trace:* ~decision:* ~security:* &* +@read +@write -@dangerous -flushall -flushdb -config
user shopsquire_celery on >replace-me-redis-celery-password ~shopsquire.celery* ~shopsquire:celery:* &* +@read +@write +eval -@dangerous -flushall -flushdb -config
user shopsquire_obs on >replace-me-redis-obs-password ~shopsquire:metrics:* &* +@read +@write -@dangerous -flushall -flushdb -config

