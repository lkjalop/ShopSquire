    "price_query": {
      "subject": "Wholesale pricing — {item}",
      "body": "Hi {supplier_name},\n\nCould you share current wholesale pricing and any season/volume discounts for {item}? {details}\n\nDraft for review.\n\nKind regards,\n{sender_name}"
