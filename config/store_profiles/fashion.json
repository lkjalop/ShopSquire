  "_ranking_rules_comment": "ADAPTER (Phase 2A): use-case ranking rules. A rule fires when use_case matches; each met condition (metric op value) adds delta+reason. Metrics from spec_extraction_rules. Consumed by recommend_ranking.use_case_rank_adjustment.",
  "ranking_rules": [
    {
      "use_cases": [
        "summer",
        "casual"
      ],
      "conditions": [
