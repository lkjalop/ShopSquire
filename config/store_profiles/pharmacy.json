{
  "_comment": "PHARMACY StoreProfile — the agnostic proof. Same shape as electronics.json, totally different flavour. As each electronics flavour slot is excised from the core into a profile read, this profile proves the core stays agnostic: a pharmacy query must NOT inherit laptop brands, GPU specs, or laptop price bands. Today only brand_price_floors + nqe_brand_detect are profile-backed; this profile grows as R2/R3 excise more slots. A high-stakes/regulated vertical is the right proof because the control/evidence moat (claim-guard, policy gate, audit) matters most here.",
  "id": "pharmacy",
  "version": "2026-06-19",

  "_complexity_keywords_comment": "Domain-specific terms that signal a complex query needing medium+ model tier. Zero laptop/GPU tokens.",
  "complexity_keywords": [
    "interaction", "contraindication", "dosage", "schedule", "pregnancy", "breastfeeding",
    "renal", "hepatic", "allergy", "adverse", "side effect", "overdose", "therapeutic",
    "pharmacokinetic", "bioavailability", "half-life", "controlled substance", "schedule 4",
    "schedule 8", "compounding", "formulation", "excipient"
  ],

  "known_brands": ["panadol","nurofen","chemists own","blackmores","swisse","cenovis","bioglan","sukin","cetaphil","dettol","listerine","betadine"],
  "nqe_brand_detect": ["panadol","nurofen","blackmores","swisse","cenovis","bioglan","sukin","cetaphil","dettol"],

  "_manufacturers_comment": "Agnostic proof: the SAME 3-axis schema (manufacturer / product line / vs type) with pharmacy flavour and zero laptop/GPU tokens. Lines are product ranges (Panadol Osteo, Swisse Ultiboost).",
  "manufacturers": {
    "panadol":    {"lines": ["panadol osteo","panadol rapid"], "aliases": ["panadol"]},
    "nurofen":    {"lines": ["nurofen zavance"], "aliases": ["nurofen"]},
    "blackmores": {"lines": ["bio c","fish oil"], "aliases": ["blackmores"]},
    "swisse":     {"lines": ["ultiboost"], "aliases": ["swisse"]},
    "cetaphil":   {"lines": ["gentle cleanser","daily moisturiser"], "aliases": ["cetaphil"]}
  },

  "primary_types": ["medicine","supplement","personal_care"],
  "price_bands_usd": {"medicine":[2,80],"supplement":[5,120],"personal_care":[3,60],"first_aid":[2,50],"baby":[3,90],"device":[10,400],"accessory":[2,200]},

  "_product_type_rules_comment": "Agnostic proof: the SAME mechanism (product_classifier) classifies pharmacy products from THIS profile — zero laptop/GPU flavour. Ordered, first-match-wins, specific before primary.",
  "spec_units": ["mg","ml","mcg","iu","g"],
  "gpu_prefixes": [],
  "product_type_rules": [
    {"type": "device",        "pattern": "\\b(thermometer|blood pressure monitor|bp monitor|nebuli[sz]er|glucose|pulse oxim|inhaler device|hot water bottle|heat pack)\\b"},
    {"type": "first_aid",     "pattern": "\\b(bandage|plaster|band-?aid|gauze|antiseptic|wound|dressing|first aid|sting relief)\\b"},
    {"type": "baby",          "pattern": "\\b(nappy|nappies|diaper|baby formula|infant formula|baby wipe|teething)\\b"},
    {"type": "personal_care", "pattern": "\\b(shampoo|conditioner|moisturi[sz]er|sunscreen|toothpaste|cleanser|body wash|soap|deodorant|lip balm|hand cream)\\b"},
    {"type": "supplement",    "pattern": "\\b(vitamin|multivitamin|fish oil|omega-?3|probiotic|magnesium|collagen|zinc|calcium|supplement|herbal)\\b"},
    {"type": "medicine",      "pattern": "\\b(paracetamol|ibuprofen|aspirin|antihistamine|panadol|nurofen|tablet|capsule|syrup|lozenge|cough|cold|flu|pain relief|antacid|laxative)\\b"}
  ],
  "brand_price_floors_usd": {"blackmores":10,"swisse":8,"cetaphil":8,"cenovis":6},
  "use_case_budget_floors": {"pain_relief":5,"cold_flu":6,"allergy":8,"vitamins":10,"skincare":8,"baby_care":6},
  "use_case_patterns": {
    "pain_relief": "\\b(pain|headache|migraine|ache|aches|sore|cramp|analgesic|paracetamol|ibuprofen|nurofen|panadol)\\b",
    "cold_flu": "\\b(cold|flu|cough|congestion|sore throat|fever|decongestant|sinus|blocked nose)\\b",
