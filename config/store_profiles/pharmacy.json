  "_nqe_question_packs_comment": "Pharmacy-domain NQE clarifying questions. Zero laptop/GPU/gaming content.",
  "nqe_question_packs": {
    "ask_symptom_type": {
      "trigger_use_cases": ["pain_relief", "cold_flu"],
      "answered_field": "symptom_type",
      "text": "Can you describe the main symptom? This helps me suggest the right product.",
      "goal": "refine_symptom",
      "evidence_needed": ["symptom_type"],
      "source": "use_case_disambiguation",
      "options": [
        {"label": "Headache / migraine", "value": "headache"},
        {"label": "Body aches / muscle pain", "value": "body_pain"},
        {"label": "Joint pain / arthritis", "value": "joint_pain"},
        {"label": "Period pain / cramps", "value": "period_pain"},
        {"label": "Sore throat / cough", "value": "throat_cough"},
        {"label": "Blocked nose / congestion", "value": "congestion"}
      ]
    },
    "ask_drowsy_preference": {
      "trigger_use_cases": ["allergy"],
      "answered_field": "drowsy_preference",
      "text": "Do you need a non-drowsy option (for daytime) or is drowsy/sedating OK?",
      "goal": "refine_formulation",
      "evidence_needed": ["drowsy_preference"],
      "source": "use_case_disambiguation",
      "options": [
        {"label": "Non-drowsy (daytime use)", "value": "non_drowsy"},
        {"label": "Drowsy is OK (nighttime / sleep aid)", "value": "drowsy_ok"},
        {"label": "Not sure — recommend the most popular", "value": "no_preference"}
      ]
    },
    "ask_health_goal": {
      "trigger_use_cases": ["vitamins"],
      "answered_field": "health_goal",
      "text": "What's your main health goal? This helps narrow the right supplement.",
      "goal": "refine_use_case",
      "evidence_needed": ["health_goal"],
      "source": "use_case_disambiguation",
      "options": [
        {"label": "Immune support / general wellness", "value": "immune"},
        {"label": "Energy / fatigue", "value": "energy"},
        {"label": "Bone / joint health", "value": "bone_joint"},
        {"label": "Skin / hair / nails", "value": "beauty"},
        {"label": "Gut health / digestion", "value": "gut_health"},
        {"label": "Pregnancy / prenatal", "value": "prenatal"}
      ]
    },
    "ask_skin_type": {
      "trigger_use_cases": ["skincare"],
      "answered_field": "skin_type",
      "text": "What's your skin type? This helps match the right formulation.",
      "goal": "refine_formulation",
      "evidence_needed": ["skin_type"],
      "source": "use_case_disambiguation",
      "options": [
        {"label": "Dry / sensitive", "value": "dry_sensitive"},
        {"label": "Oily / acne-prone", "value": "oily_acne"},
        {"label": "Combination", "value": "combination"},
        {"label": "Normal — just looking for basics", "value": "normal"}
      ]
    },
    "ask_age_band": {
      "trigger_use_cases": ["baby_care"],
      "answered_field": "age_band",
      "text": "How old is the baby/child? Age determines the right formulations and dosages.",
      "goal": "refine_eligibility",
      "evidence_needed": ["age_band"],
      "source": "use_case_disambiguation",
      "options": [
        {"label": "Newborn (0–3 months)", "value": "newborn"},
        {"label": "Infant (3–12 months)", "value": "infant"},
        {"label": "Toddler (1–3 years)", "value": "toddler"},
        {"label": "Child (3–12 years)", "value": "child"}
      ]
    }
  },

  "spec_constraints": {
    "pack_size":   {"pattern": "\\b(\\d{1,3})\\s*(pack|tablets|capsules|caps)\\b", "field": "pack_size_min"},
    "strength_mg": {"pattern": "\\b(\\d{2,4})\\s*mg\\b", "field": "strength_mg"}
  },

  "_regulatory_comment": "Pharmacy is WHY the control moat matters: dosage/age/schedule are POLICY, not recommendation. These belong in the merchant policy + execution gate, not the recommender.",
  "policy_flags": {
    "schedule_gated": true,
    "age_restricted_types": ["medicine"],
    "no_health_claims_without_evidence": true,
    "max_pack_per_order_enforced": true
  },

  "upsell_companions": {
    "medicine":      ["first_aid","device"],
    "supplement":    ["personal_care"],
    "personal_care": ["supplement"]
  },

