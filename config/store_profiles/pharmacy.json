    "vitamins": "\\b(vitamin|multivitamin|supplement|immune|wellness|mineral|fish oil|omega|probiotic)\\b",
    "skincare": "\\b(skin ?care|skin|moisturi\\w*|cleanser|acne|eczema|dry skin|sunscreen|spf)\\b",
    "baby_care": "\\b(baby|infant|nappy|nappies|diaper|formula|teething|baby wipe)\\b"
  },

  "use_cases": {
