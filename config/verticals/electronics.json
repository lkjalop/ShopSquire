{
  "id": "electronics",
  "version": "2026-02-05",
  "name": "Electronics Returns + CV",
  "strict_required_views": false,
  "required_views": {
    "views": ["front", "back", "serial", "label", "receipt"],
    "keywords": {
      "front": ["front", "overview", "product"],
      "back": ["back", "rear"],
      "serial": ["serial", "sn", "s_n", "imei"],
      "label": ["label", "shipping", "tracking"],
      "receipt": ["receipt", "invoice", "order"]
    },
    "min_images": 1
  },
  "taxonomy": {
    "categories": ["laptop", "phone", "tablet", "monitor", "accessory", "receipt_document"],
    "damage_types": ["screen_crack", "body_dent", "hinge_damage", "scratch", "water_damage", "unknown"]
  },
  "allowed_substitutions": {
    "category_substitutions": {
      "notebook": "laptop",
      "ultrabook": "laptop",
      "display": "monitor"
    }
  },
  "thresholds": {
    "auto_approve_max_score": 30,
    "human_review_max_score": 70,
    "escalate_security_min_score": 70,
    "image_quality_min": 0.6
  },
  "ocr_patterns": {
    "serial": [
      "S/?N[:\\s-]*([A-Z0-9\\-]{6,24})",
      "Serial[:\\s]*([A-Z0-9\\-]{6,24})",
      "IMEI[:\\s]*([0-9]{14,17})"
    ],
    "order_id": [
      "Order[:\\s#]*([A-Z0-9\\-]{6,32})",
      "Invoice[:\\s#]*([A-Z0-9\\-]{6,32})"
    ],
    "receipt_total": [
      "Total[:\\s]*\\$?([0-9]+\\.[0-9]{2})"
    ]
  },
  "roi_allowlist": [
    "product",
    "packaging_box",
    "shipping_label",
    "barcode",
    "qr_code",
    "serial_plate",
    "screen",
    "hinge",
    "receipt_document"
  ]
}
