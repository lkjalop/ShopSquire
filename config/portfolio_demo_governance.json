    "human_preview_required": true,
    "substitution_requires_separate_confirmation": true,
    "enquiry_is_purchase_commitment": false
  },
  "commercial": {
    "default_currency": "AUD",
    "supported_display_currencies": ["AUD", "USD", "EUR", "GBP"],
    "exchange_rate_authority": "not_enrolled",
    "high_value_order_review_threshold_cents": 3000000,
    "high_value_quantity_review": {
      "quantity_greater_than": 10,
      "unit_price_at_least_cents": 400000
    },
    "high_value_review_enforcement": "portfolio_advisory_only",
    "high_value_review_resolution_owners": ["tenant_policy", "human"],
    "stretch_shelf_visible": true,
    "finance_eligibility_authority": "none",
    "cart_mutation_requires_explicit_confirmation": true
  },
  "narration": {
    "mode": "shadow_only",
    "buyer_renderer": "deterministic_authorized_blocks",
    "unsupported_claim_tolerance": 0,
    "material_omission_tolerance": 0,
    "latency_limit_ms": 8000,
    "consecutive_latency_runs": 3,
    "commercial_authority": false
  },
  "buyer_experience": {
    "technical_execution_details": "decision_trace_or_drill_down",
