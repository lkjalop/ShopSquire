  },
  "relevance": {
    "review_type": "owner_non_independent",
    "reviewer_id": "leoma-owner-review-v1",
    "rubric": {"2": "direct fit", "1": "useful compromise", "0": "irrelevant or materially unsuitable"},
    "price_in_pure_relevance": false,
    "availability_scored_separately": true,
    "status": "pending_owner_judgments"
  },
  "voice": {
    "certification_required_for_portfolio_demo": false,
    "may_propose_commercial_action": true,
    "may_confirm_commercial_action": false,
    "text_confirmation_required": true
  },
  "compatibility_v2": {
    "retirement_eligible": false,
    "review_order": "last"
  }
