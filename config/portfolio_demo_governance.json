{
  "schema_version": "portfolio-demo-governance-v1",
  "profile_id": "shopsquire-portfolio-demo",
  "environment_class": "local_developer_certification",
  "production_claim": false,
  "tenants": {
    "mode": "deny_by_default",
    "enrolled_ids": ["default", "portfolio-demo"],
    "real_identity_enrollment": false
  },
  "research": {
    "discovery": "local_searxng",
    "canonical_origin_first": true,
    "paid_discovery": "disabled",
    "repeat_research_requires_refresh_authorization": true,
    "source_text_retention": "none",
    "retained_evidence": ["content_hash", "normalized_claim", "execution_receipt"],
    "publisher_policy_owner": "leoma-project-owner",
    "publisher_policy_id": "leoma-publisher-policy-v1"
  },
  "freshness_sla_hours": {
    "product_specification": 720,
    "product_identity_mpn": 720,
    "price": 24,
    "retail_availability": 24,
    "supplier_availability": 24,
    "supplier_lead_time": 24,
    "warranty": 720,
    "os_support_compatibility": 720,
    "workload_software_requirements": 720,
    "behavioral_benchmark": 2160
  },
  "stale_evidence_policy": "visible_conditional_refresh_offered",
  "supplier": {
    "mode": "synthetic_default_real_human_gated",
    "real_send_authorized": false,
    "real_send_requires": [
      "verified_supplier_identity",
      "approved_credentials",
      "human_rfq_preview",
      "explicit_send_authorization"
