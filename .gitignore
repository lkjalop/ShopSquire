# Local runtime artifacts / recordings (keep only the compact summary JSON)
runs/**
!runs/docker_pytest_results.json

# Local dumps, logs, and DB volumes (do not commit)
dump/
logs/
pgdata/

# Local scripted run outputs (keep scripts, not their outputs)
scripts/runs/

# One-off local collection artifacts
collected_*

# Local model weights (download separately as needed)
/yolov8*.pt
/models/*.pt

# Playbook version snapshots can be noisy in dev; keep curated ones only.
config/security/versions/playbooks/*.json

*.sqlite
*.db
*.sqlite-journal
test.sqlite*

node_modules/
dist/
build/

.venv/
venv/
.venv_new/

# Editor / tool local state
.claude/settings.local.json

# Local Docker/backup artifacts
compose.effective.yml
*.bundle
