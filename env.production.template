## ShopSquire — production environment template
## Copy to .env and fill every REQUIRED field before deploying.
## Never commit a .env file with real secrets.

# ── Runtime ────────────────────────────────────────────────────────────────────
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8080

# ── Database (Postgres + pgvector required) ────────────────────────────────────
# REQUIRED — must include credentials and point to production host
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/shopsquire

# ── Redis / Celery ─────────────────────────────────────────────────────────────
# REQUIRED — must include password; TLS (rediss://) required in production
REDIS_URL=rediss://default:STRONG_PASSWORD@HOST:6380/0
CELERY_BROKER_URL=rediss://default:STRONG_PASSWORD@HOST:6380/0
CELERY_RESULT_BACKEND=rediss://default:STRONG_PASSWORD@HOST:6380/0

# ── API Keys ───────────────────────────────────────────────────────────────────
# REQUIRED — rotate all three from the defaults
MERCHANT_API_KEY=<generate-with-openssl-rand-hex-32>
OWNER_API_KEY=<generate-with-openssl-rand-hex-32>
DEVELOPER_API_KEY=<generate-with-openssl-rand-hex-32>
API_KEYS_PATH=config/api_keys.json

# ── Vault (preferred over .env for secrets in production) ──────────────────────
VAULT_ADDR=https://vault.internal
VAULT_TOKEN=<vault-token>
VAULT_API_KEYS_PATH=shopsquire/api_keys

# ── Stripe (live keys required in production) ──────────────────────────────────
# REQUIRED — sk_live_... keys; sk_test_ will cause startup rejection
STRIPE_API_KEY=sk_live_<replace>
STRIPE_WEBHOOK_SECRET=whsec_<replace>
STRIPE_BILLING_ENABLED=1
STRIPE_METERED_PRICE_ID=<price-id>

# ── PayPal ─────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=<replace>
PAYPAL_CLIENT_SECRET=<replace>

# ── LLM providers ──────────────────────────────────────────────────────────────
# Set at least one of Ollama or OpenAI. Ollama failure falls back to OpenAI.
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_SMALL_MODEL=qwen2.5:14b
OLLAMA_MEDIUM_MODEL=qwen2.5:14b
OLLAMA_BIG_MODEL=mixtral:8x7b

# ── Email security LLM (air-gapped — never use external API for email content) ─
# mistral-small3.2 (Ollama tag: mistral-small:24b) for multi-doc synthesis/verdict
EMAIL_SECURITY_LLM_PROVIDER=ollama
EMAIL_SECURITY_LLM_MODEL=mistral-small:24b
EMAIL_LLM_ASSIST_ENABLED=1

# ── Security matrix / CV analysis LLM ─────────────────────────────────────────
CV_ANALYSIS_LLM_PROVIDER=ollama
CV_ANALYSIS_LLM_MODEL=qwen2.5:14b

# ── Action verifier ─────────────────────────────────────────────────────────────
VERIFIER_LLM_MODEL=qwen2.5:14b
VERIFIER_SCORE_THRESHOLD=0.70
VERIFIER_CORRECTIVE_RAG_ENABLED=1

# ── OpenAI fallback (optional but recommended for resilience) ──────────────────
OPENAI_API_KEY=sk-<replace>
OPENAI_FALLBACK_MODEL=gpt-4o-mini
GOOGLE_AI_API_KEY=<replace-if-using-gemini>

# ── CV / Vision ────────────────────────────────────────────────────────────────
CV_VISION_ENABLED=1
CV_VISION_MODEL=llava:latest
OLLAMA_VISION_MODEL=llava:latest
CV_PROVIDER=ollama
CV_MODEL=llava

# ── CORS ───────────────────────────────────────────────────────────────────────
# REQUIRED — set to your actual frontend domain(s); localhost not included in production
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ── Security / Compliance ──────────────────────────────────────────────────────
# All required in non-dev environments (startup rejects if missing)
PG_ENCRYPTION_AT_REST=1
RETENTION_CLEANUP_ENABLED=1
AUDIT_CHAIN_EXTERNAL_ANCHOR_MODE=s3   # options: s3, gcs, azure, webhook
BACKUP_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
CLICK_PROTECT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_SIGNING_KEY=<generate-with-openssl-rand-hex-64>
JWT_ISSUER=shopsquire
JWT_AUDIENCE=shopsquire-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=86400
REDIS_REQUIRE_TLS=1

# ── OAuth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<replace>
GOOGLE_CLIENT_SECRET=<replace>
GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback

# ── Webhooks ───────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>
GITHUB_WEBHOOK_SECRET=<replace>
SLACK_WEBHOOK_SECRET=<replace>
SHOPIFY_WEBHOOK_SECRET=<replace>
WEBHOOK_ENFORCE_VENDOR_SIGNATURES=true

# ── ERP / EDI ──────────────────────────────────────────────────────────────────
# Mock mode is OFF by default in production; enable only for integration testing
ERP_EDI_ENABLED=1
ERP_EDI_MOCK_MODE=0
ERP_EDI_BASE_URL=https://your-erp-host/api
ERP_CONNECTOR_TYPE=rest

# ── Vuln scanning ──────────────────────────────────────────────────────────────
VULN_SCAN_ENABLED=1
VULN_SCAN_WEB_ENABLED=1
NUCLEI_TEMPLATES_PATH=/nuclei-templates

# ── GNN / Neo4j fraud graph ────────────────────────────────────────────────────
FRAUD_GRAPH_NEO4J_ENABLED=1
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<replace>

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/shopsquire/api.log
JAEGER_ENABLED=true
PROMETHEUS_METRICS_PORT=8000

# ── Demo routes ────────────────────────────────────────────────────────────────
# Must remain 0 in production to disable /demo/* endpoints
ENABLE_DEMO_ROUTES=0

# ── Token budget ───────────────────────────────────────────────────────────────
TOKEN_BUDGET_ENABLED=true
TOKEN_BUDGET_DEFAULT_TIER=guest
TOKEN_BUDGET_GUEST_DAILY_TOKENS=1000
TOKEN_BUDGET_BASIC_DAILY_TOKENS=10000
TOKEN_BUDGET_PREMIUM_DAILY_TOKENS=100000
TOKEN_BUDGET_ENTERPRISE_DAILY_TOKENS=1000000

# ── Model protection ───────────────────────────────────────────────────────────
MODEL_THEFT_GUARD_ENABLED=1
MODEL_THEFT_MAX_EXTRACTION_REQ_PER_HOUR=40
MODEL_THEFT_WATERMARK_KEY=<generate-with-openssl-rand-hex-32>

# ── Security autorouting ───────────────────────────────────────────────────────
SECURITY_AUTOROUTE_ENABLED=true
SECURITY_ESCALATE_MIN_SEVERITY=high
SECURITY_ESCALATE_MIN_SCORE=70
SECURITY_REVIEW_MIN_SEVERITY=warn
SECURITY_REVIEW_MIN_SCORE=30

# ── ElevenLabs TTS (optional) ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=<replace-if-using-voice>
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Xero (optional) ────────────────────────────────────────────────────────────
XERO_API_BASE=https://api.xero.com
XERO_TENANT_ID=<replace>
XERO_ACCESS_TOKEN=<replace>

# ── Vector search ──────────────────────────────────────────────────────────────
VECTOR_SEARCH_ENABLED=1

# ── Supply chain integrity ─────────────────────────────────────────────────────
SUPPLY_CHAIN_ENABLED=true
SUPPLY_CHAIN_CHECK_TTL=3600
SUPPLY_CHAIN_BASELINE_TTL=604800
SUPPLY_CHAIN_BASELINES_PATH=config/security/supply_chain_baselines.json
WEBHOOK_ENFORCE_VENDOR_SIGNATURES=true


# ── Audit chain integrity ──────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
AUDIT_CHAIN_SECRET=<generate-with-openssl-rand-hex-32>

# ── Security block mode ────────────────────────────────────────────────────────
# Set to 403 in production to fail-closed on security blocks (default=200 is fail-open)
SECURITY_BLOCK_MODE=403

# ── MAESTRO agentic boundary enforcement mode ──────────────────────────────────
# audit  = log violations only, never block (default — safe for all environments)
# warn   = log violations, emit warning but continue
# block  = raise 403 for critical/high violations — only enable after boundary audit
MAESTRO_ENFORCEMENT_MODE=audit

# ── Click-protect HMAC ────────────────────────────────────────────────────────
CLICK_PROTECT_SECRET=<generate-with-openssl-rand-hex-32>

# ── Qwen3 thinking mode ────────────────────────────────────────────────────────
QWEN3_THINK_ENABLED=1
QWEN3_THINK_SCORE_THRESHOLD=7
