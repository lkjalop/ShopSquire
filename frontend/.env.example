# Frontend env — copy the relevant lines into local, gitignored files.
#
# IMPORTANT (security): Vite inlines every VITE_* var into the built bundle at `npm run build`. A secret
# placed in a file that build loads (.env, .env.local, .env.production) SHIPS in the JS bundle. So:
#
#   • DEV CREDENTIALS  → frontend/.env.development.local   (loaded ONLY by `npm run dev`, never by build)
#   • NON-SECRET config → frontend/.env.local              (loaded in all modes)
#
# tests/test_no_bundled_demo_key.py fails the suite if a known dev key leaks into a built dist.

# --- frontend/.env.development.local (dev only; do NOT commit) ---
VITE_API_KEY=local-merchant-key          # must equal backend MERCHANT_API_KEY (dev default)
VITE_OWNER_API_KEY=local-owner-key       # must equal backend OWNER_API_KEY (dev default)

# --- frontend/.env.local (all modes; non-secret only) ---
VITE_API_BASE_URL=http://localhost:8080

# For a PUBLIC/production build: do NOT bake a merchant key. Set a strong backend MERCHANT_API_KEY via
# env and have the app obtain its key at runtime (owner-key modal / cookie), leaving VITE_API_KEY unset.
